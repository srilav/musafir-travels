# Copy to backend/.env for local development. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://musafir:musafir@localhost:5433/musafir
JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes
JWT_EXPIRY_MINUTES=43200
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional extra origin regex. Wildcards in ALLOWED_ORIGINS (e.g. https://*.vercel.app) also work.
ALLOWED_ORIGIN_REGEX=

# Conversational trip creation (AI-spec.md). Disabled by default.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
